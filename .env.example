# ---- AI 연계 (Gemini 무료 API) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-2
GEMINI_TIMEOUT_SEC=20
LLM_ENABLED=true
LLM_SEND_IMAGE=false
RAG_ENABLED=true
AGENT_LLM_GUIDANCE=false
AGENT_ESCALATE_DARK=true
DARK_BRIGHTNESS_THRESHOLD=60
# 챗봇(/chat) — false 면 문서 발췌로만 답함
CHAT_ENABLED=true
