# ---- DB (MySQL) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bus_safety

# ---- 인증 ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720
# Google 로그인 클라이언트 ID (여러 개면 쉼표로 구분)
GOOGLE_CLIENT_ID=

# ---- 자녀 위치 암호화 (Fernet 키, README 참고. 없으면 서버 시작 안 됨) ----
LOCATION_ENCRYPTION_KEY=

# ---- 인원 감지 모델 ----
# real: 실제 YOLO 추론 / mock: 시연용 가짜 결과
DETECTOR_MODE=real
# 서비스 모델: k5 단일 모델
YOLO_MODEL=weights/bus_person_k5_final_26s_1109_0926.pt
# 앙상블을 시험하려면 쉼표로 여러 모델을 적는다 (있으면 YOLO_MODEL보다 우선)
# YOLO_MODELS=weights/bus_person_k5_final_26s_1109_0926.pt,weights/bus_person_1029_0718.pt,weights/yolo11s.pt
CONF_THRESHOLD=0.25
LOW_CONF_THRESHOLD=0.5

# ---- 푸시 (Firebase 서비스 계정 JSON 경로, 저장소에 올리지 말 것) ----
FIREBASE_SERVICE_ACCOUNT_FILE=
FCM_ANDROID_CHANNEL_ID=safety_alerts

# ---- AI 연계 (Gemini 무료 API) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-2
GEMINI_TIMEOUT_SEC=20
LLM_ENABLED=true
LLM_SEND_IMAGE=false
RAG_ENABLED=true
AGENT_LLM_GUIDANCE=false
AGENT_ESCALATE_DARK=true
DARK_BRIGHTNESS_THRESHOLD=60
# 챗봇(/chat) — false 면 문서 발췌로만 답함
CHAT_ENABLED=true


# ---- 네이버 위치 검색 ----
NAVER_MAPS_CLIENT_ID=
NAVER_MAPS_CLIENT_SECRET=
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# ---- 사진 보관 (지나면 파일·DB 사진 자동 삭제) ----
UPLOAD_DIR=uploads
IMAGE_RETENTION_DAYS=14
# 결석 사유 첨부파일 보관 기간 (비워 두면 IMAGE_RETENTION_DAYS 와 같음)
# ATTENDANCE_FILE_RETENTION_DAYS=14
# 학부모 앱에서 한 달에 결석할 수 있는 날 수 (기본 4)
# MONTHLY_ABSENCE_LIMIT=4
# UPLOAD_DIR 이 상대 경로면 프로젝트 폴더 기준으로 저장됨 (실행 위치와 무관)

